# ── Vercel C · apps/admin · secret matrix (teacher-lms/01 §8, /06 §8) ──
# Superadmin console: cross-tenant READ via is_admin() + audited corpus/role WRITE
# routes. Holds NO billing (Polar) / R2 / Expo secret — that isolation is the point.

# Supabase (same project as apps/web + apps/teacher-web)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, RLS-bypass corpus/role writes (audited)
DATABASE_URL=                       # postgres.js (advisory-lock exam_simulations id allocation)

# Upstash Redis — distinct key prefix tc:* (may share one instance with A/B)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (admin sign-in form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
