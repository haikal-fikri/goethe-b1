# ─────────────────────────────────────────────────────────────
# apps/website — Marketing-Website (Next.js + Payload CMS)
# ─────────────────────────────────────────────────────────────

# Supabase-Postgres (geteiltes Projekt). Payload legt seine Tabellen im
# eigenen Schema `payload` an — die App-Tabellen bleiben unberührt.
# WICHTIG: Session-Pooler (Port 5432) verwenden. Der Transaction-Pooler
# (6543) blockiert DDL, Payload-Migrationen schlagen dort fehl.
DATABASE_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres

# Signiert Payload-Sessions. Beliebiger langer Zufallsstring.
PAYLOAD_SECRET=

# Öffentliche Basis-URL (Metadata, sitemap.xml, JSON-LD, OG-Bilder).
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Kontaktformular — Resend (gleiche Konvention wie apps/web).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Digital Sprache Institut

# Optional: Größe des Verbindungs-Pools. Standard 2 — bewusst klein, weil der
# Supabase-Session-Pooler insgesamt nur 15 Verbindungen zulässt und diese App
# sie sich mit web, teacher-web und admin teilt.
DATABASE_POOL_MAX=2

# Rate-Limit (geteiltes Upstash-Konto, Präfix rl:site:*).
# Fehlen die Werte, ist das Rate-Limiting deaktiviert (nur Dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Medien-Uploads → Cloudflare R2 (S3-kompatibel), eigener Bucket.
# Fehlen die Werte, speichert Payload lokal (nur Dev; nicht deploy-fest).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
