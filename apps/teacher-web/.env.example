# ── Vercel B · apps/teacher-web · secret matrix (teacher-lms/01 §8, /06 §8) ──
# Server-only secrets are NEVER NEXT_PUBLIC_-prefixed (CI web-audit enforces this).

# Supabase (same project as apps/web + apps/mobile)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, RLS-bypass writes (grades/entitlements/invites/notify)
DATABASE_URL=                       # postgres.js (session-pooler / direct; NOT the 6543 tx pooler)

# Groq (writing grade + Whisper transcription) — shared with apps/web
GROQ_API_KEY=
GRADING_ENABLED=true                # kill-switch for the AI writing-grade path
TRANSCRIBE_ENABLED=true             # kill-switch for the Whisper finalize path

# Polar (Merchant-of-Record) — Vercel B ONLY
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_STARTER_PRODUCT_ID=           # -> entitlements.plan 'starter' (€99/yr)
POLAR_PRO_PRODUCT_ID=               # -> entitlements.plan 'pro'     (€249/yr)

# Cloudflare R2 (private speaking-audio bucket) — Vercel B ONLY
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Expo push (Neue Klassenaufgaben etc.) — Vercel B ONLY
EXPO_ACCESS_TOKEN=

# Resend (invite + result emails) — shared with apps/web
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# Upstash Redis — distinct key prefix tb:* (may share one instance with A/C)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron auth (generate-sessions / purge-audio / fair-use-sweep / session-reminders /
# close-terms / retention-sweep) — Vercel B ONLY
CRON_SECRET_B=

# Cloudflare Turnstile (teacher sign-in form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Speechace (DEFERRED — no schema change when added; behind §3.9 legal gate)
SPEECHACE_API_KEY=
