# --- Supabase (Auth + Client-Reads) ---
# PFLICHT für die Mobile-App-Auth (Magic-Link/Google/Apple/OTP) und die
# authentifizierten /api-Pfade. URL + anon key sind öffentlich (RLS schützt);
# der service-role key ist server-only und darf NIE ins Mobile-Bundle
# (CI-Bundle-Audit erzwingt das). Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: privilegierte Writes (exam_results-Persist, Avatar, Konto-Löschung).
SUPABASE_SERVICE_ROLE_KEY=

# --- KI-Prüfer Kill-Switch + Cron ---
# GRADING_ENABLED=false schaltet die Bewertung global ab (503). CRON_SECRET
# sichert spätere Cron-Jobs (Audio-Purge, GC) — Bearer-Vergleich.
GRADING_ENABLED=
CRON_SECRET=

# --- KI-Prüfer (Schreiben-Bewertung) ---
# Server-only Secret für Groq (kostenloses Tier). NICHT mit NEXT_PUBLIC_ präfixen.
# Key unter https://console.groq.com/keys erstellen.
GROQ_API_KEY=

# --- Missbrauchsschutz 1/2: Cloudflare Turnstile (Bot-/Mensch-Prüfung auf der
#     Prüfungs-Einreichung /pruefen) ---
# BEIDE setzen oder KEINS. Nur das Secret zu setzen würde jede Einreichung mit
# 403 blockieren (der Client sendet dann kein Token). NEXT_PUBLIC_* wird zur
# Build-Zeit eingebettet — Ein-/Ausschalten erfordert ein Redeploy (auf Vercel
# automatisch bei Env-Änderung). Widget + Keys unter
# https://dash.cloudflare.com → Turnstile. Ohne Keys ist die Prüfung deaktiviert.
# Test-Keys: Site 1x00000000000000000000AA / Secret
# 1x0000000000000000000000000000000AA (beide immer OK); 2x… = immer Fehler.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Missbrauchsschutz 2/2: Upstash Redis (strikte Pro-IP-Ratenbegrenzung für
#     /api/exam/grade + /api/exam/email) ---
# Aktiv NUR, wenn beide gesetzt sind; sonst No-Op (lokale Entwicklung ohne
# Upstash läuft normal). Kostenlose DB unter https://console.upstash.com →
# Redis → REST-URL + Token. Ein Account/eine DB reicht; die Web-Schlüssel sind
# unter `rl:web:*` isoliert (die Mobile-App kann dieselbe DB teilen).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin-Panel (Simulationen anlegen) ---
# Server-only. ADMIN_PASSWORD = Login-Passwort; ADMIN_SESSION_SECRET = HMAC-Key
# für das Session-Cookie (z.B. `openssl rand -hex 32`). NICHT mit NEXT_PUBLIC_
# präfixen, nicht committen.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- E-Mail-Versand (Ergebnis an Lehrkraft + Lernende:n schicken) ---
# Server-only. RESEND_API_KEY ist Pflicht zum Senden (https://resend.com/api-keys).
# RESEND_FROM_EMAIL/RESEND_FROM_NAME sind optional. Standard-Absender ist der
# Resend-Sandbox-Absender onboarding@resend.dev — der liefert NUR an die
# E-Mail-Adresse des Resend-Kontoinhabers. Für echten Versand an Dritte eine
# eigene Domain in Resend verifizieren und RESEND_FROM_EMAIL darauf setzen.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# --- Stripe — Pay-what-you-want-Checkout (/pay) ---
# Server-only Secret. sk_test_… zum Testen (Karte 4242 4242 4242 4242),
# sk_live_… in Produktion. NICHT mit NEXT_PUBLIC_ präfixen, nicht committen.
STRIPE_SECRET_KEY=

# --- Nur fürs Einspielen von Schema + Korpus (psql) ---
# Session-Pooler- ODER Direct-Connection-URI von Supabase
# (Settings → Database → Connection string). NICHT der Transaction-Pooler (6543).
DATABASE_URL=
