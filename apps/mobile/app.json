{
  "expo": {
    "name": "Satzwerk",
    "slug": "b1trainer",
    "scheme": "satzwerk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.satzwerk.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Satzwerk erkennt deine Aussprache auf dem Gerät, um Feedback zu geben.",
        "NSMicrophoneUsageDescription": "Satzwerk nutzt das Mikrofon für die Ausspracheübung (auf dem Gerät, nichts wird gespeichert)."
      }
    },
    "android": {
      "package": "de.satzwerk.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Satzwerk nutzt das Mikrofon für Sprechübungen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Satzwerk braucht Zugriff auf deine Fotos, um ein Profilbild zu wählen."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Satzwerk nutzt das Mikrofon für die Ausspracheübung (auf dem Gerät, nichts wird gespeichert).",
          "speechRecognitionPermission": "Satzwerk erkennt deine Aussprache auf dem Gerät, um Feedback zu geben."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9f4c5aab-bc06-4127-9ba4-fa890ef1db32"
      }
    },
    "owner": "haikal-fikris-team"
  }
}
