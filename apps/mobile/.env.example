# Mobile-Client-Env — NUR EXPO_PUBLIC_* (zur Build-Zeit inlined). NIEMALS Secrets
# hier (kein service-role, kein Groq/DB) — der CI-Bundle-Audit erzwingt das.
# Kopiere nach apps/mobile/.env.local und fülle die Werte.

# Supabase (öffentlich; RLS schützt). Dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Trusted Server (Vercel-Projekt A) — Basis-URL für /api/*.
EXPO_PUBLIC_API_BASE=

# LMS-Backend (Vercel-Projekt B, teacher-web) — Basis-URL für /api/speaking/*.
# Anderer Origin/Port als API_BASE; fürs echte Gerät die LAN-IP verwenden.
EXPO_PUBLIC_LMS_API_BASE=

# Cloudflare Turnstile Site-Key (Bot-Check im OTP-Fallback).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Google Sign-In Client-IDs (aus Google Cloud Console; für die native Anmeldung).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
