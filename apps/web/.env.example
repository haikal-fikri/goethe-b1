# --- App-Laufzeit (optional) ---
# Die App läuft im MVP ohne Datenbank: sie liest den gebündelten
# Korpus-Snapshot src/content/corpus.json. Diese Variablen sind nur nötig,
# wenn du die App später direkt aus Supabase lesen lässt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- KI-Prüfer (Schreiben-Bewertung) ---
# Server-only Secret für Groq (kostenloses Tier). NICHT mit NEXT_PUBLIC_ präfixen.
# Key unter https://console.groq.com/keys erstellen.
GROQ_API_KEY=

# --- Admin-Panel (Simulationen anlegen) ---
# Server-only. ADMIN_PASSWORD = Login-Passwort; ADMIN_SESSION_SECRET = HMAC-Key
# für das Session-Cookie (z.B. `openssl rand -hex 32`). NICHT mit NEXT_PUBLIC_
# präfixen, nicht committen.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- E-Mail-Versand (Ergebnis an Lehrkraft + Lernende:n schicken) ---
# Server-only. RESEND_API_KEY ist Pflicht zum Senden (https://resend.com/api-keys).
# RESEND_FROM_EMAIL/RESEND_FROM_NAME sind optional. Standard-Absender ist der
# Resend-Sandbox-Absender onboarding@resend.dev — der liefert NUR an die
# E-Mail-Adresse des Resend-Kontoinhabers. Für echten Versand an Dritte eine
# eigene Domain in Resend verifizieren und RESEND_FROM_EMAIL darauf setzen.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# --- Stripe — Pay-what-you-want-Checkout (/pay) ---
# Server-only Secret. sk_test_… zum Testen (Karte 4242 4242 4242 4242),
# sk_live_… in Produktion. NICHT mit NEXT_PUBLIC_ präfixen, nicht committen.
STRIPE_SECRET_KEY=

# --- Nur fürs Einspielen von Schema + Korpus (psql) ---
# Session-Pooler- ODER Direct-Connection-URI von Supabase
# (Settings → Database → Connection string). NICHT der Transaction-Pooler (6543).
DATABASE_URL=
